<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>

  <UsingTask TaskName="PathProbeTask" AssemblyFile="$(MSBuildThisFileDirectory)..\..\ProbeTask\bin\Release\net462\ProbeTask.dll" TaskFactory="TaskHostFactory" />

  <Target Name="RunPathProbe" AfterTargets="Build">
    <Message Importance="High" Text="MSBuild $(MSBuildVersion), BuildingInsideVisualStudio: $(BuildingInsideVisualStudio), bin: $(MSBuildBinPath)" />
    <PathProbeTask Label="ide-TaskHost" />
  </Target>
</Project>
